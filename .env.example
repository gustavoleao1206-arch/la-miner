# ─────────────────────────────────────────────────────────────
#  LEÃO AMORIM MINER — variáveis de ambiente
#  Copie para .env e preencha. O .env NUNCA vai para o git.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Banco ──
# SEM valor de exemplo nas senhas, de propósito: os defaults antigos
# (`miner_dev`, `redis_dev`) estavam publicados neste arquivo versionado e eram
# os que a máquina de desenvolvimento realmente usava — quem alcançasse a porta
# já tinha a credencial. Gere uma:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
POSTGRES_USER=miner
POSTGRES_PASSWORD=
POSTGRES_DB=miner
POSTGRES_PORT=5432
# O compose prende a porta a 127.0.0.1. Só mude se souber exatamente por quê:
# este banco tem CPF, telefone e endereço de milhares de pessoas reais.
POSTGRES_BIND=127.0.0.1
DATABASE_URL="postgresql://miner:SUA_SENHA@localhost:5432/miner?schema=public"

# ── Redis (fila BullMQ) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_BIND=127.0.0.1

# ── API ──
API_PORT=3333
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# Quantos proxies existem na frente da API. CONTE, não chute: o número precisa
# ser EXATO, e errar para qualquer lado quebra em silêncio.
#   0  = acesso direto (desenvolvimento)
#   1  = um único proxy (Nginx próprio, por exemplo)
#   2  = atrás da RENDER  ← é o caso desta produção
# São 2 na Render porque ela serve o app atrás da própria Cloudflare. Isto já
# esteve em 1, e o efeito foi o rate limit MORTO: o `req.ip` resolvia para o nó
# de borda, que muda a cada requisição, e cada chamada nascia num balde novo —
# nenhum 429 jamais aparecia. Medido no log de produção, o X-Forwarded-For chega
# com duas entradas: [IP real do cliente, IP da borda].
#
# Baixo demais → o balde é o proxy (o de cima). Alto demais → o cliente forja o
# X-Forwarded-For e ESCOLHE o próprio balde, furando o rate limit de propósito e
# sujando a trilha de auditoria da LGPD. Por isso NUNCA `true`, que aceita a
# cadeia inteira.
#
# Como conferir que está certo: 8 logins seguidos com e-mail inexistente contra
# o ambiente; a 6ª tentativa tem de vir 429. Se não vier, o número está errado.
TRUST_PROXY_HOPS=0

# Ausente = ligado em desenvolvimento, DESLIGADO em produção (o refine do zod
# recusa `true` com NODE_ENV=production: o Swagger publica o mapa inteiro da API).
# SWAGGER_ENABLED=

# ── Autenticação ──
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d

# O refresh token viaja num cookie httpOnly (`miner_refresh`), nunca no corpo
# nem no sessionStorage. Estas duas decidem se o navegador vai ENVIÁ-LO — e
# errar aqui falha do pior jeito possível: o login funciona e a sessão morre 15
# minutos depois, sem erro em lugar nenhum.
#
#   strict  → web e API no MESMO SITE (ex.: app.seudominio.com.br e
#             api.seudominio.com.br). É o padrão e o mais seguro.
#   none    → web e API em sites DIFERENTES. É o caso dos domínios de fábrica
#             da Render: `onrender.com` está na Public Suffix List, então
#             miner-web.onrender.com e miner-api.onrender.com NÃO são o mesmo
#             site, e com `strict` o cookie jamais sairia do navegador.
#             Exige cookie Secure — a validação de env recusa a combinação sem.
COOKIE_SAMESITE=strict
# Ausente = ligado sozinho quando NODE_ENV=production. Só defina para HTTPS
# local; `false` em produção é recusado na subida (o token iria sem TLS).
# COOKIE_SECURE=

# ── Segundo fator (MFA/TOTP) ──
# Chave que CIFRA o segredo TOTP guardado no banco. Sem ela ninguém consegue
# LIGAR o MFA (a rota responde 503 explicando) — o resto do sistema funciona
# igual. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# ⚠ MATERIAL DE COFRE. Perder esta chave depois de haver cadastros equivale a
# apagar os segredos: cada usuário terá de entrar por um código de recuperação e
# cadastrar o app de novo. Guarde-a onde guarda as senhas do banco, não só na
# Render.
MFA_ENCRYPTION_KEY=

# Quem é OBRIGADO a ter segundo fator:
#   nenhum → opcional para todos (padrão)
#   admin  → o ADMIN da plataforma e o gestor de cada organização cliente
#   todos  → todo mundo
# Quem está em falta ENTRA (a senha continua valendo), mas só alcança as rotas de
# cadastro do próprio MFA até cumprir. Qualquer valor diferente de `nenhum` exige
# MFA_ENCRYPTION_KEY, ou a API se recusa a subir — sem a chave, exigir MFA
# trancaria todo mundo do lado de fora.
MFA_OBRIGATORIO=nenhum

# ── Provider de enriquecimento ──
# 'fake' para desenvolvimento; 'contactra' quando as credenciais reais forem informadas.
# O FakeProvider se recusa a rodar com NODE_ENV=production.
ENRICHMENT_PROVIDER=fake

# ═════════════════════════════════════════════════════════════
#  CONTACTRA — SOMENTE BACKEND. NUNCA prefixar com NEXT_PUBLIC_.
#  Preencha com as URLs e as credenciais do contrato com o provedor.
# ═════════════════════════════════════════════════════════════
CONTACTRA_BASE_URL=
CONTACTRA_CLIENT_ID=
CONTACTRA_CLIENT_SECRET=
CONTACTRA_TOKEN_URL=
# Teto de chamadas por minuto — protege o contrato contra estouro de consumo.
CONTACTRA_RATE_LIMIT_POR_MINUTO=60
CONTACTRA_TIMEOUT_MS=15000

# ═════════════════════════════════════════════════════════════
#  COBRANÇA — assinatura dos clientes
# ═════════════════════════════════════════════════════════════
# 'manual': a fatura é emitida no banco e a baixa é dada à mão pelo painel.
#           Nenhuma cobrança externa é criada. É o padrão, de propósito.
# 'asaas':  cobrança de verdade. Exige as duas variáveis abaixo, ou a API
#           SE RECUSA A SUBIR.
BILLING_PROVIDER=manual

# Chave da API. O AMBIENTE SAI DO PREFIXO DELA — não há variável separada, então
# não existe a combinação "sandbox configurado, chave de produção":
#   $aact_hmlg_...  → sandbox (https://api-sandbox.asaas.com/v3)
#   $aact_prod_...  → PRODUÇÃO, cobrança real (https://api.asaas.com/v3)
# O `$` inicial faz parte da chave. Em NODE_ENV=production a chave de sandbox é
# recusada no boot: com ela tudo pareceria funcionar e ninguém seria cobrado.
ASAAS_API_KEY=

# Segredo que o Asaas devolve no header `asaas-access-token` de todo webhook.
# É o ÚNICO guarda da rota pública que quita fatura — quem souber este valor
# marca cobranças como pagas. Mínimo de 24 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Cadastre o MESMO valor ao criar o webhook no painel do Asaas, apontando para
# https://SEU-DOMINIO/api/v1/cobranca/webhook  (HTTPS: em HTTP o segredo viaja legível)
ASAAS_WEBHOOK_TOKEN=

# UNDEFINED deixa o pagador escolher PIX ou boleto na própria fatura — as duas
# são taxa fixa. CREDIT_CARD é percentual e sai bem mais caro no ticket alto.
ASAAS_BILLING_TYPE=UNDEFINED

# Dias entre a competência e o vencimento da fatura.
COBRANCA_DIAS_VENCIMENTO=10
# Tolerância entre vencer e SUSPENDER o acesso do cliente.
COBRANCA_CARENCIA_DIAS=5
# O cron que fatura, vence e suspende. Desligado por padrão: é o mais
# consequente do sistema.
COBRANCA_AGENDADA_ATIVA=false
COBRANCA_CRON=0 5 * * *

# ── Retenção de dado pessoal (LGPD) ──
# Dias que a RESPOSTA CRUA do provedor de enriquecimento sobrevive em
# `enriquecimentos.dadosBrutos`. O que interessa já foi extraído para
# telefones/emails/enderecos na hora da consulta — o payload é cópia, e cópia
# esquecida é a que vaza.
#
# A LINHA da consulta nunca é apagada: ela é a trilha (quando consultamos, a que
# custo, com que resultado) e a conferência da fatura do provedor. Só o conteúdo
# sai. Rodando às 4h, depois da sincronização das 3h.
#
# 0 DESLIGA a limpeza — não significa "apagar tudo agora".
RETENCAO_DADOS_BRUTOS_DIAS=180

# ── Limites da conexão com o banco ──
# Sem estes, o Prisma dimensiona o pool por `num_cpus * 2 + 1` — medido: 25
# conexões numa máquina de 12 CPUs. O tamanho vira acidente do hardware, e o
# Postgres da Render tem teto baixo, COMPARTILHADO com as migrations do
# preDeploy e com qualquer segundo serviço.
DB_CONEXOES=10
# Quanto uma requisição espera por conexão livre antes de falhar. Falhar rápido
# é melhor que enfileirar até o proxy desistir.
DB_POOL_TIMEOUT_S=10
# Teto por CONSULTA (não por transação). Vinha ZERO — ilimitado —, então uma
# consulta travada segurava a conexão para sempre; bastam algumas para o pool
# acabar e a API parar de responder, sem erro em lugar nenhum.
DB_STATEMENT_TIMEOUT_MS=30000

# ── Papel deste processo ──
#   api    → serve HTTP; produz na fila, mas NÃO consome, e não roda cron
#   worker → consome a fila e dispara os crons; sem porta HTTP
#   tudo   → os dois no mesmo processo
#
# `tudo` é o padrão e é o certo em desenvolvimento: subir dois processos para
# ver uma tela seria atrito puro.
#
# Em produção, separar custa um serviço a mais na Render — e o render.yaml já
# traz os dois configurados. Se a decisão for não pagar por isso, apague o
# serviço `miner-worker` e deixe a API em `tudo`. O que NÃO pode é manter o
# worker no ar E a API em `tudo`: seriam dois consumidores da mesma fila, e os
# crons rodariam em dobro.
PAPEL_PROCESSO=tudo

# ── Distribuição mensal de carteira ──
DISTRIBUICAO_AGENDADA_ATIVA=false
DISTRIBUICAO_CRON=0 4 * * *

# ── Frontend (apps/web) ──
# Só a URL da API própria. Nenhuma credencial de provider aqui.
NEXT_PUBLIC_API_URL=http://localhost:3333/api

# ── Storage S3 (opcional) ──
S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Backup (scripts/backup.sh) ──
# Chave GPG para cifrar o dump. Sem ela o backup é gerado EM CLARO e o script
# avisa — um arquivo com os dados de milhares de titulares num bucket é
# vazamento esperando acontecer.
BACKUP_GPG_RECIPIENT=
BACKUP_RETENCAO_DIAS=30

# Planilha da carga do seed (opcional).
# Padrão: dados/carteira.xlsx na raiz do repositório — pasta ignorada pelo git,
# porque a planilha tem CPF de pessoas reais.
SEED_XLSX=
# Lote de destino da carga (opcional; padrão TRF5 / 2027).
SEED_TRIBUNAL=
SEED_EXERCICIO=

# --- Confirmacao de e-mail no cadastro publico --------------------------------
# DESLIGADA por padrao: o deploy nao muda nada. Ligar exige provedor real
# (o zod recusa fake em producao) e o DNS do dominio (SPF/DKIM) publicado.
# CONFIRMACAO_EMAIL_ATIVA=false
# CONFIRMACAO_EMAIL_VALIDADE_HORAS=48
# EMAIL_PROVIDER=fake            # fake | resend
# EMAIL_REMETENTE=nao-responda@laminer.com.br
# RESEND_API_KEY=
# WEB_URL=https://app.laminer.com.br
