# Dumps do banco — contêm a base INTEIRA: nome, CPF, telefone, e-mail e endereço
# de milhares de titulares reais. Uma vez no histórico do git, dado pessoal não
# sai mais (e um pedido de exclusão do art. 18 da LGPD não alcança commit).
backups/
*.dump
*.sql.gz
